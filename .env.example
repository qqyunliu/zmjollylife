# ================================================
# 环境变量配置示例
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ================================================

# ---- 数据库 ----
DB_PASSWORD=your_database_password_here

# ---- 管理员后台 ----
ADMIN_PASSWORD=your_admin_password_md5_hash_here

# ---- 阿里云 ----
ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
ALIYUN_REGION=cn-shanghai

# ---- 火山引擎 (内容审核) ----
VOLCENGINE_API_KEY=your_volcengine_api_key
VOLCENGINE_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
VOLCENGINE_IMAGE_MODEL=doubao-seed-2-0-mini-260215
VOLCENGINE_AUDIO_MODEL=deepseek-v3-2-251201
