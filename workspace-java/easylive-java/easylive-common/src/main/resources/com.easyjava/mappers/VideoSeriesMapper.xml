<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mabatis.org/DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.easyjava.mappers.VideoSeriesMapper">
    
    <resultMap id="base_result_map" type="com.easyjava.entity.po.VideoSeries">
        <result column="series_id" property="seriesId"/>
        <result column="user_id" property="userId"/>
        <result column="series_name" property="seriesName"/>
        <result column="series_cover" property="seriesCover"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
    
    <select id="selectListByUserId" resultMap="base_result_map">
        SELECT * FROM video_series 
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>
    
    <select id="selectById" resultMap="base_result_map">
        SELECT * FROM video_series WHERE series_id = #{seriesId}
    </select>
    
    <delete id="deleteById">
        DELETE FROM video_series WHERE series_id = #{seriesId}
    </delete>
    
    <insert id="insert" useGeneratedKeys="true" keyProperty="seriesId">
        INSERT INTO video_series (user_id, series_name, series_cover, create_time, update_time)
        VALUES (#{bean.userId}, #{bean.seriesName}, #{bean.seriesCover}, #{bean.createTime}, #{bean.updateTime})
    </insert>
    
    <update id="update">
        UPDATE video_series SET series_name = #{bean.seriesName}, series_cover = #{bean.seriesCover}, update_time = #{bean.updateTime}
        WHERE series_id = #{bean.seriesId}
    </update>
</mapper>