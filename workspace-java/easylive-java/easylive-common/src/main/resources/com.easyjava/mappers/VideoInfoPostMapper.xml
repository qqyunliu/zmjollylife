        </if>
        <if test="query.tagsFuzzy != null and query.tagsFuzzy !=''">
            and tags like concat('%',#{query.tagsFuzzy},'%')
        </if>
        <if test="query.introductionFuzzy != null and query.introductionFuzzy !=''">
            and introduction like concat('%',#{query.introductionFuzzy},'%')
        </if>
        <if test="query.interactionFuzzy != null and query.interactionFuzzy !=''">
            and interaction like concat('%',#{query.interactionFuzzy},'%')
        </if>


    </sql>
    <!--通用的查询条件-->
    <sql id="query_condition">
        <where>
            <include refid="base_query_condition"/>
            <include refid="base_query_condition_extend"/>
            <!--<include refid="base_condition_field"/>-->
            <if test="query.excludeStatusArray!=null">
                and v.status not in(<foreach collection="query.excludeStatusArray" separator="," item="item">#{item}
            </foreach> )
            </if>
            <if test="query.statusArray!=null">
                and v.status in(<foreach collection="query.statusArray" separator="," item="item">#{item}
            </foreach> )
            </if>
        </where>
    </sql>

